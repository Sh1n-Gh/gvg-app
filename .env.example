# Safe examples only. Copy to .env locally and replace production values via a secret store.
PORT=3000
DB_PATH=./db/gvg.db
MASTER_ADMIN_CODE=replace-with-a-long-random-secret
# Node 24.19.0; MASTER_ADMIN_CODE is migration input only in P04.
# Use secret-store values in production, not the examples above.
# SESSION_SECRETS: comma-separated signing keys, current first, each >=32 bytes.
SESSION_SECRETS=
# Independent random secret, >=32 bytes; must differ from every signing key.
AUTH_RATE_LIMIT_SECRET=
# Optional first migration input, >=12 Unicode characters and <=256 UTF-8 bytes.
# If omitted, migration hashes MASTER_ADMIN_CODE exactly as the legacy alias.
MASTER_ADMIN_BOOTSTRAP_PASSWORD=
# New absolute backup filename outside public/, parent directory must exist.
AUTH_MIGRATION_BACKUP_PATH=
# P04: exact browser HTTPS origin required in production, without trailing slash.
PUBLIC_ORIGIN=
# P05 removed the legacy header bridge; LEGACY_AUTH_ENABLED has no effect.
# Offline Master recovery requires a NEW private backup filename outside public/.
AUTH_RECOVERY_BACKUP_PATH=
# P09: blank/false for direct access; explicit trusted reverse proxy IP/CIDR only.
# Example for a same-host proxy: 127.0.0.1,::1 (see docs/P09-CHECKPOINT.md).
# Never use true, a hop count, or an Internet-wide subnet.
TRUST_PROXY=

# P11: optional, comma-separated EXACT HTTPS origins for external avatar/Map images.
# Empty allows same-origin uploads and local raster previews only. No wildcard/scheme/path.
# Inventory real database URLs before rollout; e.g. https://images.example.com
CSP_IMAGE_ORIGINS=

# P12: production is hard-bound to 127.0.0.1; HOST only affects development.
HOST=127.0.0.1
# Production requires TRUST_PROXY=127.0.0.1 and PUBLIC_ORIGIN=https://YOUR_DOMAIN
# (one canonical DNS hostname, standard port 443; this is also the Host allowlist).
# Production DB_PATH must be absolute and outside public/, e.g. /var/lib/gvg/gvg.db.
# See deploy/*.example and docs/DEPLOYMENT.md; do not deploy these unchanged.
# P16: trusted absolute CommonJS hook path, exporting async beforeMigrate.
# Required for pending production schema migrations; use absolute scripts/sqlite-backup.js path.
# See docs/BACKUP-RESTORE.md; configure BACKUP_DIR before using the provider.
MIGRATION_BACKUP_HOOK=

# P17: pre-create private directory outside public/; absolute paths required.
BACKUP_DIR=
BACKUP_RETENTION_DAYS=7
# Restore always requires a NEW path; never defaults to DB_PATH.
BACKUP_FILE=
RESTORE_DB_PATH=

# P20: JSON logs to stdout; production collectors need info for error-rate denominator.
LOG_LEVEL=info
# 1000..120000 ms; systemd TimeoutStopSec must exceed this plus SQLite lock wait.
SHUTDOWN_TIMEOUT_MS=30000
